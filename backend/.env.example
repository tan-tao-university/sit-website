# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sit_db

# Private API access and local authentication
# Generate all three values with: pnpm run security:generate-secrets
API_ACCESS_KEY_SHA256=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Local image uploads (stored in backend/uploads, served at /uploads)
# Base URL the backend is publicly reachable at; used to build absolute image URLs.
UPLOAD_PUBLIC_URL=http://localhost:8080
# Comma-separated previous/alternate backend origins whose /uploads URLs are managed locally.
UPLOAD_TRUSTED_ORIGINS=http://localhost:8080

# Extra CORS origins (comma-separated). localhost:3000/4000 always allowed.
# e.g. ORIGIN=https://sit-ttu.edu.vn,https://admin.sit-ttu.edu.vn
ORIGIN=

# Server
PORT=8080

# Gemini translation (not used for authentication)
GOOGLE_API_KEY=your_google_api_key
