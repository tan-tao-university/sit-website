# ── Biến DÙNG CHUNG cho app + dashboard (2 frontend Next.js) ──
# Copy file này thành `.env.shared` ở root và điền giá trị thật:
#     cp .env.shared.example .env.shared
# Cả app/ và dashboard/ tự nạp file này qua next.config.ts.
# KHÔNG prefix bằng NEXT_PUBLIC_ — các biến này chỉ dùng phía server.

# URL nội bộ tới backend API.
INTERNAL_API_URL=http://localhost:8080/api/v1

# Khóa truy cập API riêng. PHẢI khớp với API_ACCESS_KEY_SHA256 trong backend/.env
# (backend lưu bản hash sha256 của chính khóa này).
API_ACCESS_KEY=
